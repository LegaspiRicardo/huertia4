CREATE DATABASE huertia;
USE huertia;

CREATE TABLE usuarios (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    correo VARCHAR(150) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    foto_perfil VARCHAR(255),
    fecha_registro TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);



CREATE TABLE catalogo_plantas (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    nombre_cientifico VARCHAR(150),
    categoria VARCHAR(50),
    descripcion TEXT,
    dificultad ENUM(
        'facil',
        'media',
        'dificil'
    ),
    imagen VARCHAR(255),
    dias_germinacion INT,
    dias_cosecha INT,
    temperatura_min DECIMAL(5,2),
    temperatura_max DECIMAL(5,2),
    riego_recomendado VARCHAR(100),
    api_externa VARCHAR(255),
    activo BOOLEAN DEFAULT TRUE
);


CREATE TABLE plantas_usuario (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    usuario_id BIGINT NOT NULL,
    planta_id BIGINT NOT NULL,
    fecha_desbloqueo DATETIME DEFAULT CURRENT_TIMESTAMP,
    foto_principal VARCHAR(255),
    FOREIGN KEY (usuario_id)
        REFERENCES usuarios(id),
    FOREIGN KEY (planta_id)
        REFERENCES catalogo_plantas(id)
);



CREATE TABLE cultivos (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    usuario_id BIGINT NOT NULL,
    planta_id BIGINT NOT NULL,
    nombre_personalizado VARCHAR(100),
    fecha_siembra DATE,
    fecha_estimada_cosecha DATE,
    estado ENUM(
        'sembrado',
        'crecimiento',
        'floracion',
        'cosecha',
        'finalizado'
    ),
    ubicacion VARCHAR(100),
    notas TEXT,
    activo BOOLEAN DEFAULT TRUE,
    FOREIGN KEY (usuario_id)
        REFERENCES usuarios(id),
    FOREIGN KEY (planta_id)
        REFERENCES catalogo_plantas(id)
);



CREATE TABLE fotos_cultivo (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    cultivo_id BIGINT NOT NULL,
    imagen VARCHAR(255),
    descripcion TEXT,
    fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (cultivo_id)
        REFERENCES cultivos(id)
);



CREATE TABLE tipos_actividad (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50),
    icono VARCHAR(255)
);

